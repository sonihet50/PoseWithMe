<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="24dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_thumbnail">

            <com.s23cp5054.posewithme.ui.pose.PoseThumbnailView
                android:id="@+id/detailThumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/detailName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold"
                tools:text="Hand on hip" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/favoriteButton"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/favorite_add"
                app:icon="@drawable/ic_favorite_border"
                app:iconTint="@color/brand_pink" />
        </LinearLayout>

        <TextView
            android:id="@+id/detailMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/brand_accent"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Casual standing · Full body · Easy" />

        <TextView
            android:id="@+id/detailDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingMultiplier="1.15"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            tools:text="A relaxed, confident stance that works almost anywhere." />

        <TextView
            android:id="@+id/detailInstructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingMultiplier="1.25"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            tools:text="• Put one hand on your hip\n• Shift your weight to one leg" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tryPoseButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="@string/detail_try_pose"
            android:textSize="16sp"
            android:textColor="@color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/deletePoseButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:text="@string/pose_delete"
            android:textColor="@color/match_off"
            android:visibility="gone"
            app:icon="@drawable/ic_delete"
            app:iconTint="@color/match_off" />

        <TextView
            android:id="@+id/detailAttribution"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/text_secondary"
            android:textColorLink="@color/brand_primary"
            android:textSize="11sp"
            tools:text="Pose traced from “Portrait” by Jane Doe, CC BY 2.0" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
