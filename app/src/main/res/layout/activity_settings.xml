<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.settings.SettingsActivity">

    <LinearLayout
        android:id="@+id/settingsHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <ImageButton
            android:id="@+id/settingsBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/settings_title"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/settingsScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="24dp">

            <!-- Capture -->
            <TextView
                style="@style/TextAppearance.PoseWithMe.SettingsSection"
                android:text="@string/settings_section_capture" />

            <com.google.android.material.card.MaterialCardView style="@style/Widget.PoseWithMe.SettingsCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchAutoCapture"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_auto_capture"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                    <TextView
                        style="@style/TextAppearance.PoseWithMe.SettingsSummary"
                        android:text="@string/settings_auto_capture_summary" />

                    <TextView
                        android:id="@+id/thresholdLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        tools:text="Match needed for auto-capture: 85%" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/thresholdSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stepSize="5"
                        android:valueFrom="60"
                        android:valueTo="95" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/settings_countdown"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/countdownChips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        app:selectionRequired="true"
                        app:singleSelection="true" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchMirror"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/settings_mirror"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                    <TextView
                        style="@style/TextAppearance.PoseWithMe.SettingsSummary"
                        android:text="@string/settings_mirror_summary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Guidance -->
            <TextView
                style="@style/TextAppearance.PoseWithMe.SettingsSection"
                android:text="@string/settings_section_guidance" />

            <com.google.android.material.card.MaterialCardView style="@style/Widget.PoseWithMe.SettingsCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchHints"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_hints"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                    <TextView
                        style="@style/TextAppearance.PoseWithMe.SettingsSummary"
                        android:text="@string/settings_hints_summary" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchGhost"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/settings_ghost"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                    <TextView
                        style="@style/TextAppearance.PoseWithMe.SettingsSummary"
                        android:text="@string/settings_ghost_summary" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchSkeleton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/settings_skeleton"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                    <TextView
                        style="@style/TextAppearance.PoseWithMe.SettingsSummary"
                        android:text="@string/settings_skeleton_summary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Recommendations -->
            <TextView
                style="@style/TextAppearance.PoseWithMe.SettingsSection"
                android:text="@string/settings_section_recommendations" />

            <com.google.android.material.card.MaterialCardView style="@style/Widget.PoseWithMe.SettingsCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_preferred_categories"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/categoryChips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- About -->
            <TextView
                style="@style/TextAppearance.PoseWithMe.SettingsSection"
                android:text="@string/settings_section_about" />

            <com.google.android.material.card.MaterialCardView style="@style/Widget.PoseWithMe.SettingsCard">

                <TextView
                    android:id="@+id/aboutText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.2"
                    android:padding="16dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
